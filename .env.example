# Optional hosted provider; local Ollama and LM Studio require no API key.
GROQ_API_KEY=

# Local Ollama (default model); Ollama runs at localhost:11434.
OLLAMA_MODEL=qwen3:4b

# Optional local LM Studio server and loaded model id.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_API_KEY=
